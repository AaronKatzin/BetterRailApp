<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:text="@string/widget_configure_title"
            android:textColor="@color/label"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/widget_configure_description"
            android:textColor="@color/secondaryLabel"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/commute_mode_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/widget_commute_mode"
            android:textColor="@color/label"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="12dp"
            android:text="@string/widget_commute_description"
            android:textColor="@color/secondaryLabel"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/commute_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/widget_home_station"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/home_station_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/spinner_background"
                android:completionThreshold="0"
                android:dropDownHeight="300dp"
                android:hint="@string/search_origin_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/label"
                android:textColorHint="@color/secondaryLabel"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_scooter_home_to_station"
                    android:textColor="@color/label"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/scooter_home_to_station"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_background"
                    android:gravity="center"
                    android:hint="@string/widget_minutes_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/label"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_scooter_station_to_home"
                    android:textColor="@color/label"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/scooter_station_to_home"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_background"
                    android:gravity="center"
                    android:hint="@string/widget_minutes_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/label"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/widget_office_a"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/office_a_label"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/spinner_background"
                android:hint="@string/widget_office_name_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/label"
                android:textColorHint="@color/secondaryLabel"
                android:textSize="16sp" />

            <AutoCompleteTextView
                android:id="@+id/office_a_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/spinner_background"
                android:completionThreshold="0"
                android:dropDownHeight="300dp"
                android:hint="@string/search_destination_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/label"
                android:textColorHint="@color/secondaryLabel"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_scooter_station_to_office"
                    android:textColor="@color/label"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/scooter_a_station_to_office"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_background"
                    android:gravity="center"
                    android:hint="@string/widget_minutes_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/label"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_scooter_office_to_station"
                    android:textColor="@color/label"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/scooter_a_office_to_station"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_background"
                    android:gravity="center"
                    android:hint="@string/widget_minutes_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/label"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/widget_office_b"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/office_b_label"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/spinner_background"
                android:hint="@string/widget_office_name_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/label"
                android:textColorHint="@color/secondaryLabel"
                android:textSize="16sp" />

            <AutoCompleteTextView
                android:id="@+id/office_b_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/spinner_background"
                android:completionThreshold="0"
                android:dropDownHeight="300dp"
                android:hint="@string/search_destination_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/label"
                android:textColorHint="@color/secondaryLabel"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_scooter_station_to_office"
                    android:textColor="@color/label"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/scooter_b_station_to_office"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_background"
                    android:gravity="center"
                    android:hint="@string/widget_minutes_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/label"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_scooter_office_to_station"
                    android:textColor="@color/label"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/scooter_b_office_to_station"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_background"
                    android:gravity="center"
                    android:hint="@string/widget_minutes_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/label"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/widget_weekdays_title"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/weekday_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/single_route_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/widget_from_label"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/origin_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/spinner_background"
                android:completionThreshold="0"
                android:dropDownHeight="300dp"
                android:hint="@string/search_origin_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/label"
                android:textColorHint="@color/secondaryLabel"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/widget_to_label"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/destination_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/spinner_background"
                android:completionThreshold="0"
                android:dropDownHeight="300dp"
                android:hint="@string/search_destination_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/label"
                android:textColorHint="@color/secondaryLabel"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/advanced_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_advanced_label"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">

                <TextView
                    android:id="@+id/advanced_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="0"
                    android:text="›"
                    android:textColor="@color/secondaryLabel"
                    android:textSize="24sp" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/advanced_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/route_reversal_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/widget_allow_route_reversal"
                android:textColor="@color/label"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/auto_reverse_route_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/widget_auto_reverse_route"
                android:textColor="@color/label"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="16dp"
                android:text="@string/widget_auto_reverse_description"
                android:textColor="@color/secondaryLabel"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/widget_max_changes_label"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/max_changes_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/spinner_background"
                android:padding="12dp"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:padding="16dp"
                android:text="@string/widget_cancel"
                android:textColor="@color/secondaryLabel"
                android:textSize="16sp" />

            <Button
                android:id="@+id/add_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/primary_button_background"
                android:enabled="false"
                android:minWidth="120dp"
                android:padding="16dp"
                android:text="@string/widget_add"
                android:textColor="@color/whiteText"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
